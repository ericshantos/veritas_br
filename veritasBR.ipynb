        "class BaseExtractor(ABC):\n",
        "  def __init__(self, path: Path) -> None:\n",
        "    self.path = path\n",
        "\n",
        "  @abstractmethod\n",
        "  def extract(self, label: int) -> pd.DataFrame:\n",
        "    raise NotImplementedError"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "background_save": true
        },
        "id": "KLHtK1lIFDsk"
      },
      "outputs": [],
      "source": [
        "class Labels(Enum):\n",
        "  FAKE = 0\n",
        "  TRUE = 1\n",
        "\n",
        "  @classmethod\n",
        "  def to_dict(cls) -> dict[str, int]:\n",
        "    return {\n",
        "      \"fake\": cls.FAKE.value,\n",
        "      \"true\": cls.TRUE.value\n",
        "    }"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "9bPvz8btCe2_"
      },
      "source": [
        "## Fake.br Extractor"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "background_save": true
        },
        "id": "xFKATsBYFDsl"
      },
      "outputs": [],
      "source": [
        "class FakeBrExtractor(BaseExtractor):\n",
        "  def __init__(self, path: Path) -> None:\n",
        "    super().__init__(path)\n",
        "\n",
        "  def extract(self, labels: int) -> pd.DataFrame:\n",
        "    news = []\n",
        "\n",
        "    for dir in os.listdir(self.path):\n",
        "      if dir not in labels:\n",
        "        continue\n",
        "\n",
        "      label = labels[dir]\n",
        "\n",
        "      for file_path in Path(self.path / dir).glob(\"*.txt\"):\n",
        "        try:\n",
        "          content = file_path.read_text(encoding='utf-8')\n",
        "          news.append({\"content\": content, \"label\": label})\n",
        "        except Exception as e:\n",
        "          print(f\"Error reading file {file_path}: {e}\")\n",
        "\n",
        "    return pd.DataFrame(news)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "ONw3f-r2ClB0"
      },
      "source": [
        "## FakeTrue.Br Extractor"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "background_save": true
        },
        "id": "yiJP4JVaFDsl"
      },
      "outputs": [],
      "source": [
        "class FakeTrueExtractor(BaseExtractor):\n",
        "  def __init__(self, path: Path) -> None:\n",
        "    super().__init__(path)\n",
        "\n",
        "  def extract(self, file: str, label: dict[str, int]) -> pd.DataFrame:\n",
        "    df_raw = pd.read_csv(self.path / file)\n",
        "\n",
        "    fake_df = pd.DataFrame()\n",
        "    fake_df['content'] = df_raw['fake']\n",
        "    fake_df['label'] = label['fake']\n",
        "\n",
        "    real_df = pd.DataFrame()\n",
        "    real_df['content'] = df_raw['true']\n",
        "    real_df['label'] = label['true']\n",
        "\n",
        "    final_df = pd.concat([fake_df, real_df], ignore_index=True)\n",
        "\n",
        "    final_df = final_df.dropna(subset=['content'])\n",
        "\n",
        "    return final_df"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "HGTCY3Tqrnms"
      },
      "source": [
        "## FakeRecogna Extractor"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "background_save": true
        },
        "id": "wGzVRVi0FDsm"
      },
      "outputs": [],
      "source": [
        "class FakeRecognaExtractor(BaseExtractor):\n",
        "  def __init__(self, path: Path) -> None:\n",
        "    super().__init__(path)\n",
        "\n",
        "  def extract(self, file: str, label: dict[str, int]) -> pd.DataFrame:\n",
        "    df_raw = pd.read_excel(self.path / file)\n",
        "\n",
        "    news = df_raw[['Noticia', 'Classe']]\n",
        "\n",
        "    news = news.rename(columns={\n",
        "        'Noticia': 'content',\n",
        "        'Classe': 'label'\n",
        "    })\n",
        "\n",
        "    news.dropna(subset=['content', 'label'], inplace=True)\n",
        "\n",
        "    news['content'] = news['content'].astype(str)\n",
        "    news['label'] = news['label'].astype(int)\n",
        "\n",
        "    return news"
      ]
    },
